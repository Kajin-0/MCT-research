+def wait_terminal(retirement,child,account,guard,root,log,logged,started,cancelled):
+    """Bounded pending state; no resource/FD omission acceptance before terminal()."""
+    deadline=min(started+600,time.monotonic()+3)
+    while child.poll() is None:
+        if cancelled or time.monotonic()>=deadline:raise Refusal('terminal cancel/deadline')
+        if memory()['MemAvailable']<4*GIB or guard.probe(root)['available_bytes']<10*GIB:
+            raise Refusal('terminal host resource floor')
+        account.sample() # TREE ONLY; incomplete FD inventory is deferred, not passed.
+        if retirement.cg.exists():
+            k=counters(retirement.cg)
+            if int(k['memory_max'])!=MEMORY or int(k['swap_max'])!=0 or int(k['tasks_max'])!=TASKS:
+                raise Refusal('terminal kernel caps changed')
+            if any(k['memory_events'][v] for v in ['oom','oom_kill','max']) or k['pids_events'].get('max',0):
+                raise Refusal('terminal kernel cap event')
+            rows=members(retirement.cg);rss=proc(os.getpid())['rss_bytes']
+            rss+=proc(child.pid)['rss_bytes'] if child.poll() is None else 0
+            for pid,row in rows.items():
+                if row['state']!='Z':rss+=row['rss_bytes']
+            if rss>MEMORY:raise Refusal('terminal sampled RSS cap')
+        ready,_,_=select.select([child.stdout],[],[],.01)
+        if ready:
+            payload=os.read(child.stdout.fileno(),65536)
+            if logged+len(payload)>4*(1<<20):raise Refusal('terminal captured log cap')
+            log.write(payload);log.flush();logged+=len(payload)
+    proof=retirement.terminal(child)
+    account.sample() # complete final retained tree AFTER kernel/manager proof
+    return proof
 
 
