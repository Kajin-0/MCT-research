&CONTROL
 calculation='scf', prefix='r07pbe', outdir='./out',
 pseudo_dir='./pp', verbosity='high', disk_io='low', max_seconds=840,
/
&SYSTEM
 ibrav=0, nat=2, ntyp=2, nbnd=46, ecutwfc=50, ecutrho=200,
 occupations='smearing', smearing='fd', degauss=0.001,
 noncolin=.true., lspinorb=.true., nosym=.false., input_dft='PBE',
/
&ELECTRONS
 conv_thr=1d-9, mixing_beta=0.3, electron_maxstep=100,
 diagonalization='david', diago_full_acc=.true.,
 startingpot='atomic', startingwfc='atomic+random',
/
ATOMIC_SPECIES
Hg 200.59 VCA_HgCd_x0125.UPF
Te 127.60 Te_sg15_pbe_fr_v12.UPF
CELL_PARAMETERS angstrom
0 3.23 3.23
3.23 0 3.23
3.23 3.23 0
ATOMIC_POSITIONS crystal
Hg 0.00000000 0.00000000 0.00000000
Te 0.25000000 0.25000000 0.25000000
K_POINTS automatic
2 2 2 0 0 0
